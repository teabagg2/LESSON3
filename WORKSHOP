
import tkinter as tk

root = tk.Tk()
root.title("Workshop Participant Greeting")
root.geometry("500x400")
root.config(bg="lightblue")

workshop_date = "November 15, 2026"

def check_in():
    name = name_entry.get()

    if name.strip():
        output.delete("1.0", tk.END)
        output.insert(tk.END, f"Welcome, {name}!\n")
        output.insert(tk.END, f"We are happy to have you at our workshop.\n")
        output.insert(tk.END, f"Workshop Date: {workshop_date}")
    else:
        output.delete("1.0", tk.END)
        output.insert(tk.END, "Please enter your name.")

title_label = tk.Label(
    root,
    text="Workshop Participant Greeting",
    font=("Arial", 18, "bold"),
    bg="lightblue"
)
title_label.pack(pady=15)

instruction_label = tk.Label(
    root,
    text="Please enter your name below to check in.",
    font=("Arial", 12),
    bg="lightblue"
)
instruction_label.pack(pady=10)

name_label = tk.Label(
    root,
    text="Participant Name:",
    font=("Arial", 12),
    bg="lightblue"
)
name_label.pack()

name_entry = tk.Entry(
    root,
    font=("Arial", 12),
    width=30
)
name_entry.pack(pady=10)

check_button = tk.Button(
    root,
    text="Check In",
    font=("Arial", 12, "bold"),
    bg="green",
    fg="white",
    command=check_in
)
check_button.pack(pady=10)

output = tk.Text(
    root,
    height=5,
    width=45,
    font=("Arial", 11)
)
output.pack(pady=15)

root.mainloop()
